<?xml version="1.0" encoding="utf-8"?>
<!--
    Semana 9, actividad 37 (revisión de seguridad no funcional):
    cleartextTrafficPermitted="false" prohíbe explícitamente cualquier
    tráfico HTTP sin cifrar desde la app — todo debe ir por HTTPS.
    Aunque el servidor de PréstamoLab es un placeholder que nunca
    responde, esta configuración documenta la postura de seguridad
    correcta desde ahora, para cuando exista un backend real.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
