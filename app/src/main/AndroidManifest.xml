<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        POST_NOTIFICATIONS: obligatorio desde Android 13 (API 33) para
        mostrar notificaciones. Se declara aquí (requisito del sistema),
        pero se SOLICITA en tiempo de ejecución solo justo antes de
        registrar una devolución (ver SolicitudDetalleScreen.kt),
        cumpliendo mínimo privilegio (Semana 9, actividad 33).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.PrestamoLab">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
